
@model CoffeShopManagement.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm";
}

<style>
    .create-page {
        max-width: 650px;
        margin: auto;
        color: #44332b;
    }

        .create-page h2 {
            color: #4b3026;
            font-weight: bold;
            margin-bottom: 8px;
        }

    .create-description {
        color: #8b776b;
        margin-bottom: 25px;
    }

    .create-card {
        background: white;
        padding: 30px;
        border-radius: 14px;
        border: 1px solid #eee5dc;
        box-shadow: 0 4px 15px rgba(75, 48, 38, 0.06);
    }

    .create-page .form-group {
        margin-bottom: 20px;
    }

    .create-page label {
        font-weight: bold;
        margin-bottom: 8px;
        color: #4b3026;
    }

    .create-page .form-control {
        height: 42px;
        border-radius: 6px;
        border: 1px solid #d8c8ba;
    }

    .create-page .checkbox {
        padding-top: 5px;
    }

    .create-page .text-danger {
        display: block;
        margin-top: 5px;
    }

    .btn-save {
        background: #6b4535;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 6px;
    }

        .btn-save:hover {
            background: #4b3026;
            color: white;
        }

    .btn-back {
        display: inline-block;
        background: #f3eee8;
        color: #6b4535;
        padding: 10px 22px;
        border-radius: 6px;
        margin-left: 10px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-back:hover {
            background: #e8ddd2;
            color: #4b3026;
            text-decoration: none;
        }
</style>

<div class="create-page">

    <h2>Thêm sản phẩm</h2>
    <p class="create-description">
        Nhập thông tin sản phẩm mới vào hệ thống
    </p>

    <div class="create-card">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(model => model.CategoryID, "Danh mục")

                @Html.DropDownList(
                    "CategoryID",
                    null,
                    "-- Chọn danh mục --",
                    new { @class = "form-control" }
                )

                @Html.ValidationMessageFor(
                    model => model.CategoryID,
                    "",
                    new { @class = "text-danger" }
                )
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.ProductName, "Tên sản phẩm")

                @Html.EditorFor(
                    model => model.ProductName,
                    new
                         {
                             htmlAttributes = new
                             {
                        @class = "form-control",
                        placeholder = "Nhập tên sản phẩm..."
                    }}
                )

                @Html.ValidationMessageFor(
                    model => model.ProductName,
                    "",
                    new { @class = "text-danger" }
                )
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Price, "Giá sản phẩm")

                @Html.EditorFor(
                    model => model.Price,
                    new
                         {
                             htmlAttributes = new
                             {
                        @class = "form-control",
                        placeholder = "Nhập giá sản phẩm..."
                    }}
                )

                @Html.ValidationMessageFor(
                    model => model.Price,
                    "",
                    new { @class = "text-danger" }
                )
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.IsActive, "Trạng thái")

                <div class="checkbox">
                    @Html.EditorFor(model => model.IsActive)
                    <span> Đang kinh doanh</span>
                </div>

                @Html.ValidationMessageFor(
                    model => model.IsActive,
                    "",
                    new { @class = "text-danger" }
                )
            </div>

            <hr />

            <button type="submit" class="btn-save">
                Lưu sản phẩm
            </button>

            @Html.ActionLink(
                "Quay lại",
                "Index",
                null,
                new { @class = "btn-back" }
            )
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
