
@model CoffeShopManagement.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
}

<style>
    .delete-container {
        max-width: 650px;
        margin: 30px auto;
        padding: 30px;
        background: white;
        border: 1px solid #eee5dc;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(75,48,38,0.06);
    }

    .delete-title {
        color: #8b3e32;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .delete-warning {
        color: #a94442;
        margin-bottom: 25px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 15px 5px;
        border-bottom: 1px solid #eadfd2;
    }

    .detail-label {
        color: #79543b;
        font-weight: 600;
    }

    .detail-value {
        color: #333;
        text-align: right;
    }

    .delete-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn-delete {
        background: #bd4545;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 6px;
        font-weight: bold;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background: #982f2f;
            color: white;
        }

    .btn-back {
        display: inline-block;
        background: #e8dfd5;
        color: #5c4030;
        padding: 9px 18px;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #d8cabb;
            color: #5c4030;
            text-decoration: none;
        }
</style>

<div class="delete-container">
    <h2 class="delete-title">Xóa sản phẩm</h2>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <p class="delete-warning">
        Bạn có chắc chắn muốn xóa sản phẩm này không?
        Thao tác này không thể hoàn tác.
    </p>

    <div class="detail-row">
        <span class="detail-label">Tên sản phẩm</span>
        <span class="detail-value">
            @Html.DisplayFor(model => model.ProductName)
        </span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Giá sản phẩm</span>
        <span class="detail-value">
            @String.Format("{0:N0}", Model.Price) đ
        </span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Trạng thái</span>
        <span class="detail-value">
            @(Model.IsActive ? "Đang kinh doanh" : "Ngừng kinh doanh")
        </span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Danh mục</span>
        <span class="detail-value">
            @Html.DisplayFor(model => model.Category.CategoryName)
        </span>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="delete-actions">
            <input type="submit" value="Xác nhận xóa"
                   class="btn-delete" />

            @Html.ActionLink("Quay lại", "Index",
                null, new { @class = "btn-back" })
        </div>
    }
</div>
