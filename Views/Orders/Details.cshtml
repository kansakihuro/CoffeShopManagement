
@model CoffeShopManagement.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";

    decimal totalAmount = 0;
}

<h2>Chi tiết đơn hàng #@Model.OrderID</h2>

<div class="panel panel-default">
    <div class="panel-heading">
        <h4>Thông tin đơn hàng</h4>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Loại đơn hàng</dt>
            <dd>
                @(Model.OrderType == "DineIn"
                    ? "Dùng tại quán" : "Mang đi")
            </dd>

            <dt>Trạng thái</dt>
            <dd>
                @switch (Model.OrderStatus)
                {
                    case "New":
                        @:Mới
                        break;
                    case "Preparing":
                        @:Đang chuẩn bị
                        break;
                    case "Completed":
                        @:Hoàn thành
                        break;
                    case "Cancelled":
                        @:Đã hủy
                        break;
                    default:
                        @Model.OrderStatus
                        break;
                }
            </dd>

            <dt>Thời gian tạo</dt>
            <dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</dd>

            <dt>Thời gian hoàn thành</dt>
            <dd>
                @(Model.CompletedAt.HasValue
                    ? Model.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm:ss")
                    : "Chưa hoàn thành")
            </dd>

            <dt>Ghi chú</dt>
            <dd>@Model.Notes</dd>

            <dt>Bàn</dt>
            <dd>
                @(Model.CafeTable != null
                    ? Model.CafeTable.TableName : "Không có bàn")
            </dd>

            <dt>Nhân viên</dt>
            <dd>
                @(Model.Staff != null
                    ? Model.Staff.FullName : "")
            </dd>
        </dl>
    </div>
</div>

<h3>Danh sách sản phẩm</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã chi tiết</th>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            decimal subTotal = item.Quantity * item.UnitPrice;
            totalAmount += subTotal;

            <tr>
                <td>@item.OrderDetailID</td>

                <td>
                    @(item.Product != null
                        ? item.Product.ProductName : "Không xác định")
                </td>

                <td>@item.Quantity</td>

                <td>@item.UnitPrice.ToString("N0") đ</td>

                <td>@subTotal.ToString("N0") đ</td>
            </tr>
        }

        @if (!Model.OrderDetails.Any())
        {
            <tr>
                <td colspan="5" class="text-center">
                    Đơn hàng chưa có sản phẩm.
                </td>
            </tr>
        }
    </tbody>

    <tfoot>
        <tr>
            <th colspan="4" class="text-right">Tổng tiền:</th>
            <th>@totalAmount.ToString("N0") đ</th>
        </tr>
    </tfoot>
</table>

<p>
    @Html.ActionLink("Chỉnh sửa", "Edit",
            new { id = Model.OrderID },
            new { @class = "btn btn-primary" })

    @Html.ActionLink("Quay lại danh sách", "Index",
            null, new { @class = "btn btn-default" })
</p>
