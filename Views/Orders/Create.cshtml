
@model CoffeShopManagement.Models.Order

@{
    ViewBag.Title = "Tạo đơn hàng";
}

<h2>Tạo đơn hàng</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Thông tin đơn hàng</h4>
        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Nhân viên -->
        <div class="form-group">
            @Html.LabelFor(model => model.StaffID, "Nhân viên",
                     htmlAttributes: new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.DropDownList("StaffID", null,
                         new { @class = "form-control" })

                @Html.ValidationMessageFor(model => model.StaffID, "",
                         new { @class = "text-danger" })
            </div>
        </div>

        <!-- Bàn -->
        <div class="form-group" id="tableField">
            @Html.LabelFor(model => model.TableID, "Bàn",
                     htmlAttributes: new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.DropDownList("TableID", null,
                         "-- Không chọn bàn --",
                         new { @class = "form-control" })

                @Html.ValidationMessageFor(model => model.TableID, "",
                         new { @class = "text-danger" })
            </div>
        </div>

        <!-- Loại đơn hàng -->
        <div class="form-group">
            @Html.LabelFor(model => model.OrderType, "Loại đơn hàng",
                     htmlAttributes: new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.DropDownListFor(model => model.OrderType,
                         new SelectList(new[]
                         {
                        new { Value = "DineIn", Text = "Dùng tại quán" },
                        new { Value = "TakeAway", Text = "Mang đi" }
                         }, "Value", "Text"),
                         "-- Chọn loại đơn --",
                         new { @class = "form-control" })

                @Html.ValidationMessageFor(model => model.OrderType, "",
                         new { @class = "text-danger" })
            </div>
        </div>

        <!-- Trạng thái -->
        <div class="form-group">
            @Html.LabelFor(model => model.OrderStatus, "Trạng thái đơn hàng",
                     htmlAttributes: new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.DropDownListFor(model => model.OrderStatus,
                         new SelectList(new[]
                         {
                        new { Value = "New", Text = "Mới" },
                        new { Value = "Preparing", Text = "Đang chuẩn bị" },
                        new { Value = "Completed", Text = "Hoàn thành" },
                        new { Value = "Cancelled", Text = "Đã hủy" }
                         }, "Value", "Text"),
                         "-- Chọn trạng thái --",
                         new { @class = "form-control" })

                @Html.ValidationMessageFor(model => model.OrderStatus, "",
                         new { @class = "text-danger" })
            </div>
        </div>

        <!-- Ghi chú -->
        <div class="form-group">
            @Html.LabelFor(model => model.Notes, "Ghi chú",
                     htmlAttributes: new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.EditorFor(model => model.Notes,
                         new { htmlAttributes = new { @class = "form-control" } })

                @Html.ValidationMessageFor(model => model.Notes, "",
                         new { @class = "text-danger" })
            </div>
        </div>

        <!-- Nút tạo -->
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Tạo đơn hàng"
                       class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Quay lại danh sách", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>$(document).ready(function () {

            function toggleTableField() {
                var orderType = $("#OrderType").val();

                if (orderType === "TakeAway") {
                    $("#tableField").hide();
                    $("#TableID").val("");
                }
                else {
                    $("#tableField").show();
                }
            }

            // Kiểm tra khi vừa mở trang
            toggleTableField();

            // Kiểm tra khi thay đổi loại đơn
            $("#OrderType").change(function () {
                toggleTableField();
            });
        });</script>
}
