
@model CoffeShopManagement.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
}

<style>
    .form-container {
        max-width: 650px;
        margin: 30px auto;
        padding: 30px;
        background: #fffaf3;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    .form-title {
        color: #6f452c;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .form-subtitle {
        color: #888;
        margin-bottom: 25px;
    }

    .form-group label {
        color: #79543b;
        font-weight: 600;
    }

    .form-control {
        border-radius: 6px;
        border: 1px solid #d8cabb;
    }

    .btn-save {
        background: #8b5e3c;
        color: white;
        border: none;
        padding: 9px 18px;
        border-radius: 6px;
    }

        .btn-save:hover {
            background: #70472e;
            color: white;
        }

    .btn-back {
        display: inline-block;
        background: #e8dfd5;
        color: #5c4030;
        padding: 9px 18px;
        border-radius: 6px;
        text-decoration: none;
        margin-left: 8px;
    }

        .btn-back:hover {
            background: #d8cabb;
            color: #5c4030;
            text-decoration: none;
        }

    .text-danger {
        color: #a94442;
    }
</style>

<div class="form-container">
    <h2 class="form-title">Chỉnh sửa danh mục</h2>
    <p class="form-subtitle">Cập nhật thông tin danh mục</p>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.CategoryID)

        <div class="form-group">
            @Html.LabelFor(model => model.CategoryName, "Tên danh mục")
            @Html.EditorFor(model => model.CategoryName,
                new
                     {
                         htmlAttributes = new
                         {
                    @class = "form-control",
                    placeholder = "Nhập tên danh mục..."
                }
                     })
            @Html.ValidationMessageFor(model => model.CategoryName,
                "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Description, "Mô tả")
            @Html.TextAreaFor(model => model.Description,
                new
                     {
                    @class = "form-control",
                    rows = "4",
                    placeholder = "Nhập mô tả danh mục..."
                })
            @Html.ValidationMessageFor(model => model.Description,
                "", new { @class = "text-danger" })
        </div>

        <div class="checkbox">
            <label>
                @Html.CheckBoxFor(model => model.IsActive)
                Đang hoạt động
            </label>
        </div>

        <div style="margin-top: 25px;">
            <input type="submit" value="Lưu thay đổi"
                   class="btn-save" />

            @Html.ActionLink("Quay lại", "Index",
                null, new { @class = "btn-back" })
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
