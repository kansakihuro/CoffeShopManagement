
@{
    ViewBag.Title = "Dashboard";
}

<div style="background-color: #f8f3eb; padding: 25px; border-radius: 12px;">

    <h2 style="color: #5c4033; font-weight: bold;">
        Coffee Shop Dashboard
    </h2>

    <p style="color: #795548;">
        Tổng quan hoạt động kinh doanh
    </p>

    <div class="row">

        <div class="col-md-4">
            <div style="background: white; padding: 20px;
                        border-radius: 12px; margin-bottom: 20px;
                        border-left: 5px solid #795548;">
                <h4>Tổng đơn hàng</h4>
                <h2 style="color: #795548; font-weight: bold;">
                    @ViewBag.TotalOrders
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div style="background: white; padding: 20px;
                        border-radius: 12px; margin-bottom: 20px;
                        border-left: 5px solid #ff9800;">
                <h4>Đơn đang xử lý</h4>
                <h2 style="color: #ff9800; font-weight: bold;">
                    @ViewBag.ProcessingOrders
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div style="background: white; padding: 20px;
                        border-radius: 12px; margin-bottom: 20px;
                        border-left: 5px solid #2e7d32;">
                <h4>Bàn còn trống</h4>
                <h2 style="color: #2e7d32; font-weight: bold;">
                    @ViewBag.AvailableTables
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div style="background: white; padding: 20px;
                        border-radius: 12px; margin-bottom: 20px;
                        border-left: 5px solid #d32f2f;">
                <h4>Bàn đang sử dụng</h4>
                <h2 style="color: #d32f2f; font-weight: bold;">
                    @ViewBag.OccupiedTables
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div style="background: white; padding: 20px;
                        border-radius: 12px; margin-bottom: 20px;
                        border-left: 5px solid #00897b;">
                <h4>Doanh thu hôm nay</h4>
                <h2 style="color: #00897b; font-weight: bold;">
                    @(((decimal)ViewBag.TodayRevenue).ToString("N0")) đ
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div style="background: white; padding: 20px;
                        border-radius: 12px; margin-bottom: 20px;
                        border-left: 5px solid #1565c0;">
                <h4>Doanh thu tháng này</h4>
                <h2 style="color: #1565c0; font-weight: bold;">
                    @(((decimal)ViewBag.MonthRevenue).ToString("N0")) đ
                </h2>
            </div>
        </div>

    </div>

    <div style="background: white; padding: 20px;
                border-radius: 12px; margin-top: 10px;">
        <h3 style="color: #5c4033;">Quản lý hệ thống</h3>

        <p>
            @Html.ActionLink("Quản lý đơn hàng", "Index", "Orders",
                     null, new { @class = "btn btn-primary" })

            @Html.ActionLink("Quản lý bàn", "Index", "CafeTables",
                     null, new { @class = "btn btn-success" })

            @Html.ActionLink("Báo cáo doanh thu", "Index", "Revenue",
                     null, new { @class = "btn btn-warning" })
        </p>
    </div>

</div>
